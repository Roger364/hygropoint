{
  "name": "hygropoint",
  "private": true,
  "version": "1.0.0",
  "description": "HygroPoint — estimation de l'humidité relative de l'air à un point précis : 24 h passées, maintenant, 72 h à venir, calée sur les mesures des stations météo proches.",
  "type": "module",
  "license": "MIT",
  "author": "Ro (Bisse Studio)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Roger364/hygropoint.git"
  },
  "bugs": {
    "url": "https://github.com/Roger364/hygropoint/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:portable": "vite build --mode portable",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/engine.test.ts",
    "check": "npm run typecheck && npm run test && npm run build",
    "perf:deploy-check": "node scripts/deploy-check.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "leaflet": "^1.9.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "3.4.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/leaflet": "^1.9.22",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "5.1.1",
    "lighthouse": "^13.6.0",
    "tailwindcss": "4.1.17",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.0"
  }
}
